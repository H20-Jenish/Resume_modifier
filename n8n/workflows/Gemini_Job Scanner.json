    {
      "parameters": {
        "jsCode": "const body = $input.all()[0].json.body;\n\nlet urls = Array.isArray(body.urls) \n  ? body.urls \n  : (typeof body.urls === 'string' ? body.urls.split(',').map(u => u.trim()) : []);\n  \nlet roles = Array.isArray(body.roles) \n  ? body.roles \n  : (typeof body.roles === 'string' ? body.roles.split(',').map(r => r.trim()) : []);\n\nif (urls.length === 0) urls = [\"\"];\nif (roles.length === 0) roles = [\"\"];\n\nconst results = [];\n\nfor (const url of urls) {\n  for (const role of roles) {\n    if (!url) continue;\n    results.push({\n      json: {\n        url: url,\n        role: role,\n        location: body.location\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "id": "54a270f4-effb-44bf-9ddd-b328828fb594",
      "name": "Prepare URLs and Roles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -208,
        -176
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Please scrape the following job listing URL: {{ $json.url }}\n\nExtract the required fields to help the user. Their target role for this specific search is: {{ $json.role }} and location preference is {{ $json.location }}.",
        "options": {
          "systemMessage": "You are a job scraping assistant. Your task is to use the crawl4AI tool to fetch raw text from the provided URL, and extract the job title, company, location, required skills (as an array), and a cleaned 1000-character description.\n\nCRITICAL: You must return ONLY raw, valid JSON. Do not wrap the JSON in markdown code blocks (e.g., no ```json). Do not add any conversational text, greetings, or explanations before or after the JSON object. Your entire response must be parseable by a standard JSON parser. \n\nExpected JSON format:\n{\n  \"job_title\": \"\",\n  \"company\": \"\",\n  \"location\": \"\",\n  \"skills_required\": [],\n  \"jd_text\": \"\"\n}"
        }
      },
      "id": "e1a70da8-e8dd-4a7a-84b9-f7a322ec8811",
      "name": "Job Scraping Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        32,
        -176
      ]
    },
    {
      "parameters": {
        "jsCode": "const outputText = $input.first().json.output || \"\";\n\n// Strip away markdown formatting and stray text\nconst cleanJson = outputText.replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet parsedData = {};\ntry {\n  parsedData = JSON.parse(cleanJson);\n} catch (e) {\n  // Fallback if the model completely fails to output JSON\n  parsedData = { error: \"Failed to parse JSON\", rawText: cleanJson };\n}\n\nreturn [{ json: { output: parsedData } }];"
      },
      "id": "4ef3f987-bfb4-4d37-bc27-d3493fd56868",
      "name": "Parse Scraped JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -176
      ]
    },
    {
      "parameters": {
        "text": "=You are a job analyst. Evaluate the following scraped listing against the candidate profile.\n\nScraped Job Data:\n{{ JSON.stringify($json.output) }}\n\nCandidate Resume:\n{{ $('Receive Scan from Backend').first().json.body.resume_text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a job listing analyzer. Given the scraped text of a job posting and a candidate's profile, return a JSON analysis.\n\nScoring rules:\n- All scores are 0.0 to 5.0\n- fit_score = overall fit score\n- Match quality MUST consider candidate profile fields: location, past job titles, and total experience.\n- legitimacy_status: \"active\"=normal open listing, \"closed\"=position filled/expired, \"suspicious\"=vague/spammy/no real company info, \"uncertain\"=can't determine\n- fit_recommendation: \"apply\" if fit_score >= 3.5, \"skip\" if fit_score < 2.0, \"review\" otherwise"
        }
      },
      "id": "2d297427-25f8-4366-8df3-24bae6301f11",
      "name": "Job Analyst Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
