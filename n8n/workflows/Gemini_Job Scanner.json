{
  "name": "Job Scanner - Bypass Tool Calling",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "job-scan",
        "options": {
          "responseData": "{\"status\":\"processing\",\"message\":\"Scan started. Check listings feed for results.\"}"
        }
      },
      "id": "bd346162-8641-4f5f-a5e8-f5985f4713b9",
      "name": "Receive Scan from Backend",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -480,
        -176
      ],
      "webhookId": "job-scan-ondemand"
